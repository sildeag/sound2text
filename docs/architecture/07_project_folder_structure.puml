' ===========================
' RELATIONSHIPS
' ===========================
' Shared ViewModels depend on shared interfaces
ProfileViewModel --> StorageService
AudioViewModel --> AudioSession
AudioViewModel --> STTService
AudioViewModel --> TranscriptionController
' Platform implementations satisfy shared interfaces
StorageService <|.. AndroidStorageService
StorageService <|.. DesktopStorageService
AudioSession <|.. AndroidAudioSession
AudioSession <|.. DesktopAudioSession
STTService <|.. AndroidSTTService
STTService <|.. DesktopSTTService
' DI modules connect everything
coreModules --> StorageService
coreModules --> AudioSession
coreModules --> STTService
uiSharedModules --> ProfileViewModel
uiSharedModules --> AudioViewModel
androidPlatformModules --> AndroidStorageService
desktopPlatformModules --> DesktopStorageService
